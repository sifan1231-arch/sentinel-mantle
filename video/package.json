{
  "name": "@sentinel/video",
  "version": "1.0.0",
  "private": true,
  "description": "Sentinel Arena — the 2:09 demo trailer (Remotion, renders to MP4 programmatically).",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render SentinelArena out/sentinel-arena.mp4 --concurrency=2",
    "still": "remotion still SentinelArena out/poster.png --frame=1320",
    "still:frame": "remotion still SentinelArena out/frame.png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.286",
    "remotion": "4.0.286",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
