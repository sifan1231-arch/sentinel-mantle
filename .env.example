# ============================================================
# Sentinel — environment template. Copy to ".env" and fill in.
# A THROWAWAY wallet is strongly recommended for testnet.
# ============================================================

# --- REQUIRED for deploy + agent ---
# Private key of your deployer/agent wallet (0x-prefixed, 64 hex chars).
# Fund it with free testnet MNT at https://faucet.mantle.xyz
PRIVATE_KEY=0xyour_throwaway_private_key_here

# --- REQUIRED for contract verification on mantlescan ---
# One free Etherscan API key works for Mantle via Etherscan API V2.
# Get it at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_v2_api_key

# --- NETWORK (defaults are correct for Mantle Sepolia testnet) ---
MANTLE_SEPOLIA_RPC=https://rpc.sepolia.mantle.xyz
MANTLE_MAINNET_RPC=https://rpc.mantle.xyz
# Which network the agent/web talk to: mantleSepolia | mantle
NETWORK=mantleSepolia

# --- OPTIONAL: separate hot key for the agent (defaults to PRIVATE_KEY) ---
# AGENT_PRIVATE_KEY=0x...

# --- OPTIONAL: LLM enrichment for natural-language rationale ---
# The agent runs fully WITHOUT this (deterministic engine). If set, it adds
# richer human-readable reasoning to each decision.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# --- OPTIONAL: Allora decentralized-inference forecast feed ---
# ALLORA_API_KEY=
# ALLORA_TOPIC_ETH=

# --- OPTIONAL: real price feed source for the Scout (defaults to CoinGecko public) ---
PRICE_SOURCE=coingecko

# --- OPTIONAL: ERC-8004 canonical registry (verified defaults below) ---
# Testnet (chainId 5003)
ERC8004_IDENTITY_TESTNET=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_TESTNET=0x8004B663056A597Dffe9eCcC1965A193B7388713
# Mainnet (chainId 5000)
ERC8004_IDENTITY_MAINNET=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION_MAINNET=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63

# --- OPTIONAL: public agent-card URI (off-chain registration file) ---
AGENT_CARD_URI=https://raw.githubusercontent.com/sifan1231-arch/sentinel-mantle/main/agent/agent-card.json
