{
  "name": "@sentinel/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Sentinel on-chain components for Mantle (DecisionRegistry, SentinelVault, SentinelOracle, mock RWA pool).",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.ts --network mantleSepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network mantle",
    "node:local": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "seed:local": "hardhat run scripts/seed-and-demo.ts --network localhost",
    "deploy:arena": "hardhat run scripts/deploy-arena.ts --network mantleSepolia",
    "deploy:arena:local": "hardhat run scripts/deploy-arena.ts --network localhost",
    "verify": "hardhat run scripts/verify.ts --network mantleSepolia",
    "register": "hardhat run scripts/register-erc8004.ts --network mantleSepolia",
    "seed": "hardhat run scripts/seed-and-demo.ts --network mantleSepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.17",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2",
    "@types/node": "^20.17.6"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0"
  },
  "license": "MIT"
}
